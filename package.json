{
  "name": "recallia",
  "version": "0.1.0",
  "private": true,
  "description": "Recallia — a personal memory companion",
  "workspaces": [
    "apps/*",
    "services/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
  "dev:ingestion": "npm run dev --workspace=ingestion",
  "build": "npm run build --workspaces --if-present",
  "test": "npm run test --workspaces --if-present",
  "lint": "npm run lint --workspaces --if-present",
  "typecheck": "npm run typecheck --workspaces --if-present"
},
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.1"
  }
}
